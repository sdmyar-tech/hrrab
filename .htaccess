# Untuk hosting yang document root-nya folder proyek (mis. Hostinger public_html):
# semua request diarahkan ke public/, file & folder internal Laravel tidak bisa diakses dari web.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(\.env|\.git|\.github|app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/.*)?$ - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|seed_gm\.php)$ - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
